# PostgreSQL connection string. Keep the real value in .env only.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pocketpilot
PORT=3000
APP_BASE_URL=http://localhost:3000
DATA_MODE=replay
EXECUTION_MODE=paper
NODE_ENV=development
REPLAY_SPEED=1000
PAPER_FEE_BPS=5
PAPER_SLIPPAGE_BPS=2

# Hyperliquid execution is server-only, testnet-only, and ignored while EXECUTION_MODE=paper.
# Enabling it requires every field below plus EXECUTION_MODE=hyperliquid-testnet. Never use a
# personal/mainnet key. Prefer a dedicated testnet API wallet authorized by the funded account.
HYPERLIQUID_NETWORK=testnet
HYPERLIQUID_TESTNET_ENABLED=false
HYPERLIQUID_API_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_SIGNER_KIND=
HYPERLIQUID_EXECUTION_TIMEOUT_MS=8000
HYPERLIQUID_STATUS_POLL_INTERVAL_MS=500
HYPERLIQUID_STATUS_POLL_ATTEMPTS=6
HYPERLIQUID_MARKET_SLIPPAGE_BPS=10

# Offline-safe default. Use openai only with the server-side key configured below.
LLM_PROVIDER=fixture
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=1

# Expo Push Service. EXPO_ACCESS_TOKEN is needed only when push security is enabled in Expo.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
EXPO_PUSH_TIMEOUT_MS=10000

# Live market ingestion. Hyperliquid asset contexts have no provider timestamp, so receipt time is
# used and labelled. Keep explicit symbol/market mappings narrow.
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_SYMBOL_MAP={"BTC":"BTC","ETH":"ETH"}
HYPERLIQUID_RECONNECT_BASE_MS=500
HYPERLIQUID_RECONNECT_MAX_MS=30000
HYPERLIQUID_RECONNECT_LIMIT=10
HYPERLIQUID_RECONNECT_JITTER=0.2
HYPERLIQUID_HEARTBEAT_MS=30000

POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
# Selected on 2026-08-25; replace it when inactive/closed. "No" means BTC stays above $45k.
POLYMARKET_MARKETS_JSON=[{"marketId":"701502","asset":"BTC","outcome":"No","meaning":"Bitcoin remains above $45,000 through December 31, 2026"}]
POLYMARKET_POLL_INTERVAL_MS=15000
MARKET_HTTP_TIMEOUT_MS=10000
MARKET_FRESHNESS_SECONDS=120
MARKET_ALIGNMENT_SECONDS=120

# The Expo app reads its API URL from app/.env (see app/.env.example).
